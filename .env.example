DATABASE_URL=your_database_url_here
ALERT_CRON_SECRET=your_secret_here
# Optional: backup AQI source used when Open-Meteo fails. Free token at https://aqicn.org/data-platform/token/
WAQI_TOKEN=
# Optional: DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=INFO
# Optional: set to false to turn rate limiting off for local testing. Never in production.
RATE_LIMIT_ENABLED=true
# Optional: whether to read the client IP from X-Forwarded-For. Detected automatically on Render and Cloud Run.
# TRUST_PROXY=true
